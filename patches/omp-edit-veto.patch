+	async emitEditPrepared(
+		event: EditPreparedEvent,
+		signal?: AbortSignal,
+	): Promise<EditPreparedEventResult | undefined> {
+		const freeze = (value: unknown): void => {
+			if (value === null || typeof value !== "object" || Object.isFrozen(value)) return;
+			for (const child of Object.values(value)) freeze(child);
+			Object.freeze(value);
+		};
+		freeze(event);
+		const ctx = this.createContext();
+		const timeoutMs = normalizeHandlerTimeout(
+			this.settings?.get("extensionHandlers.toolCallTimeoutMs") ?? extensionHandlerTimeoutMs,
+		);
+		for (const ext of this.extensions) {
+			for (const handler of ext.handlers.get("edit_prepared") ?? []) {
+				const result = await this.#runHandlerWithTimeout<EditPreparedEvent, unknown>(
+					handler,
+					event,
+					ctx,
+					ext,
+					timeoutMs,
+					(kind, message) => ({ block: true, reason: `Edit held: extension ${ext.path} ${kind}: ${message}` }),
+					signal,
+				);
+				if (signal?.aborted) return { block: true, reason: "Edit held: checking was cancelled" };
+				if (result === undefined) continue;
+				if (
+					typeof result !== "object" ||
+					result === null ||
+					("block" in result && typeof result.block !== "boolean") ||
+					("reason" in result && result.reason !== undefined && typeof result.reason !== "string")
+				) {
+					return { block: true, reason: `Edit held: invalid guard result from ${ext.path}` };
+				}
+				if ("block" in result && result.block) {
+					return {
+						block: true,
+						reason: "reason" in result && typeof result.reason === "string" ? result.reason : undefined,
+					};
+				}
+			}
+		}
+		if (signal?.aborted) return { block: true, reason: "Edit held: checking was cancelled" };
+		return undefined;
+	}
+
 	async emitUserBash(event: UserBashEvent): Promise<UserBashEventResult | undefined> {
 		return this.emitUserEvent<UserBashEventResult>(event, "user_bash");
 	}
