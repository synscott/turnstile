--- /dev/null
+++ b/crates/pi-edit/tests/guard.rs
@@ -0,0 +1,92 @@
+//! Whole-call guard regressions: originals, provenance, and stale release.
+mod common;
+
+use async_trait::async_trait;
+use common::{DiskWriter, Workspace};
+use pi_edit::{ApplyRequest, EditError, EditGuard, EditMode, EditResult, PreparedOperation};
+
+struct Check<'a> {
+	ws:           &'a Workspace,
+	deny:         bool,
+	change_store: bool,
+}
+
+#[async_trait]
+impl EditGuard for Check<'_> {
+	async fn check(&self, operations: &[PreparedOperation<'_>]) -> EditResult<()> {
+		assert_eq!(operations.len(), 2);
+		assert_eq!(operations[0].before, Some("first\n"));
+		assert_eq!(operations[0].after, Some("FIRST\n"));
+		assert_eq!(operations[1].before, Some("second\n"));
+		assert_eq!(operations[1].after, Some("SECOND\n"));
+		assert_eq!(self.ws.read("a.txt").as_deref(), Some("first\n"));
+		assert_eq!(self.ws.read("b.txt").as_deref(), Some("second\n"));
+		// Recency-only reads must not invalidate permission.
+		self.ws.store.head(&self.ws.cwd().join("a.txt"));
+		if self.change_store {
+			self.ws.store.clear();
+		}
+		if self.deny {
+			Err(EditError::apply("quality finding"))
+		} else {
+			Ok(())
+		}
+	}
+}
+
+#[tokio::test]
+async fn complete_guard_denies_and_store_changes_invalidate_release() {
+	let ws = Workspace::new(EditMode::ApplyPatch);
+	ws.write("a.txt", "first\n");
+	ws.write("b.txt", "second\n");
+	let input = "*** Begin Patch\n*** Update File: a.txt\n@@\n-first\n+FIRST\n*** Update File: \
+	             b.txt\n@@\n-second\n+SECOND\n*** End Patch";
+	for (deny, change_store) in [(true, false), (false, true), (false, false)] {
+		let mut session = ws.session();
+		session.set_args_json(&serde_json::json!({ "input": input }).to_string());
+		session.finish();
+		let result = session
+			.apply(
+				ApplyRequest::default(),
+				&DiskWriter::default(),
+				Some(&Check { ws: &ws, deny, change_store }),
+			)
+			.await;
+		if deny || change_store {
+			assert!(result.is_err());
+			assert_eq!(ws.read("a.txt").as_deref(), Some("first\n"));
+			assert_eq!(ws.read("b.txt").as_deref(), Some("second\n"));
+		} else {
+			result.unwrap();
+			assert_eq!(ws.read("a.txt").as_deref(), Some("FIRST\n"));
+			assert_eq!(ws.read("b.txt").as_deref(), Some("SECOND\n"));
+		}
+	}
+}
+
+struct Overwrite<'a>(&'a Workspace);
+#[async_trait]
+impl EditGuard for Overwrite<'_> {
+	async fn check(&self, operations: &[PreparedOperation<'_>]) -> EditResult<()> {
+		assert_eq!(operations[0].op, "create");
+		assert_eq!(operations[0].before, Some("original\n"));
+		assert_eq!(operations[0].after, Some("replacement\n"));
+		self.0.write("a.txt", "external\n");
+		Ok(())
+	}
+}
+
+#[tokio::test]
+async fn create_overwrite_keeps_real_preimage_and_rejects_disk_drift() {
+	let ws = Workspace::new(EditMode::Patch);
+	ws.write("a.txt", "original\n");
+	let mut session = ws.session();
