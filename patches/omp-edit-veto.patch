+/// Exact original filesystem image retained only for guarded application.
+#[derive(Debug, PartialEq, Eq)]
+pub struct OriginalFile {
+	pub canonical: PathBuf,
+	parent:        PathBuf,
+	links:         Vec<(PathBuf, PathBuf)>,
+	pub content:   Option<String>,
+}
+
+impl OriginalFile {
+	fn read(path: &Path) -> EditResult<Self> {
+		let content = match std::fs::read(path) {
+			Ok(bytes) => Some(String::from_utf8(bytes).map_err(|_| {
+				EditError::apply(format!("Edit held: non-UTF-8 input: {}", path.display()))
+			})?),
+			Err(error) if error.kind() == std::io::ErrorKind::NotFound => None,
+			Err(source) => return Err(EditError::Io { path: path.to_owned(), source }),
+		};
+		// Resolve the nearest existing ancestor too: a create under missing
+		// directories must notice a symlink/reparse-point rebinding above them.
+		let parent = path
+			.ancestors()
+			.skip(1)
+			.find_map(|ancestor| {
+				std::fs::canonicalize(ancestor)
+					.ok()
+					.map(|resolved| resolved.join(path.strip_prefix(ancestor).expect("ancestor prefix")))
+			})
+			.unwrap_or_else(|| path.to_owned());
+		let mut links = Vec::new();
+		for ancestor in path.ancestors() {
+			if std::fs::symlink_metadata(ancestor).is_ok_and(|meta| meta.file_type().is_symlink()) {
+				let target = std::fs::read_link(ancestor)
+					.map_err(|source| EditError::Io { path: ancestor.to_owned(), source })?;
+				links.push((ancestor.to_owned(), target));
+			}
+		}
+		Ok(Self { canonical: canonical_key(path), parent, links, content })
+	}
+}
