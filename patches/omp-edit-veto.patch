+++ b/packages/coding-agent/test/edit-prepared.test.ts
@@ -0,0 +1,252 @@
+import { afterAll, beforeAll, expect, it } from "bun:test";
+import { mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import * as os from "node:os";
+import * as path from "node:path";
+import { hashlineFileHash } from "@oh-my-pi/pi-natives";
+import { ModelRegistry } from "@oh-my-pi/pi-coding-agent/config/model-registry";
+import { Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import type { EditPreparedEvent, ExtensionFactory } from "@oh-my-pi/pi-coding-agent/extensibility/extensions/types";
+import { flushLspWritethroughBatch } from "@oh-my-pi/pi-coding-agent/lsp";
+import { getConfig } from "@oh-my-pi/pi-coding-agent/lsp/config";
+import { createAgentSession } from "@oh-my-pi/pi-coding-agent/sdk";
+import { SessionManager } from "@oh-my-pi/pi-coding-agent/session/session-manager";
+import { createInMemoryAuthStorage } from "./helpers/agent-session-setup";
+
+let root: string;
+const auth = createInMemoryAuthStorage();
+let registry: ModelRegistry;
+beforeAll(async () => {
+	root = await mkdtemp(path.join(os.tmpdir(), "omp-edit-prepared-"));
+	registry = new ModelRegistry(auth, path.join(root, "models.yml"));
+});
+afterAll(async () => {
+	auth.close();
+	await rm(root, { recursive: true, force: true });
+});
+
+async function createWorkspace(extensions: ExtensionFactory[], settings: Settings, enableLsp = false) {
+	const cwd = await mkdtemp(path.join(root, "workspace-"));
+	const result = await createAgentSession({
+		cwd,
+		agentDir: cwd,
+		modelRegistry: registry,
+		sessionManager: SessionManager.inMemory(cwd),
+		settings,
+		extensions,
+		disableExtensionDiscovery: true,
+		toolNames: ["edit"],
+		enableMCP: false,
+		enableLsp,
+		skipPythonPreflight: true,
+		skills: [],
+		rules: [],
+		contextFiles: [],
+		promptTemplates: [],
+		slashCommands: [],
+		preloadedCustomToolPaths: [],
+		workspaceTree: { rootPath: cwd, rendered: "", truncated: false, totalLines: 0, agentsMdFiles: [] },
+	});
+	return { ...result, cwd };
+}
+
+it("guards final rewritten native input rather than retained custom-wire preview", async () => {
+	let permit = false;
+	let prepared: EditPreparedEvent | undefined;
+	const original = "old\n";
+	const header = `[target.txt#${hashlineFileHash(original)}]`;
+	const authored = { input: `${header}\nPUT 1.=1:\n+streamed` };
+	const rewritten = { input: `${header}\nPUT 1.=1:\n+effective` };
+	const { session, cwd } = await createWorkspace(
+		[
+			api => {
+				expect(api.supportsEditPrepared()).toBe(true);
+				api.on("tool_call", event => (event.toolName === "edit" ? { input: rewritten } : undefined));
+				api.on("edit_prepared", event => {
+					prepared = event;
+					expect(Object.isFrozen(event.operations[0])).toBe(true);
+					return { block: !permit, reason: "quality finding" };
+				});
+			},
+		],
+		Settings.isolated({ "edit.enforceSeenLines": false }),
+	);
+	try {
+		const target = path.join(cwd, "target.txt");
+		await writeFile(target, original);
+		const edit = session.getToolByName("edit")!;
+		const stream = edit.openArgStream!({
+			toolCallId: "guarded-stream",
+			toolName: "edit",
+			customWireName: "edit",
+			emit: () => {},
+		})!;
+		stream.push(authored.input);
+		stream.end(authored);
+		const denied = await edit.execute("guarded-stream", authored);
+		expect(denied.isError).toBe(true);
+		expect(prepared?.input).toEqual(rewritten);
+		expect(prepared?.operations[0]?.after).toBe("effective\n");
+		expect(await readFile(target, "utf8")).toBe(original);
+		permit = true;
+		const allowed = await edit.execute("guarded-retry", authored);
+		expect(allowed.isError).not.toBe(true);
+		expect(await readFile(target, "utf8")).toBe("effective\n");
+	} finally {
+		await session.dispose();
+	}
+});
+
+it("extension failure and abort while awaiting the native guard never release writes", async () => {
+	let action: "throw" | "wait" = "throw";
+	const entered = Promise.withResolvers<void>();
+	const { session, cwd } = await createWorkspace(
+		[
+			api => {
+				api.on("edit_prepared", async () => {
+					if (action === "throw") throw new Error("required analyzer unavailable");
+					entered.resolve();
+					return Promise.withResolvers<{ block: boolean }>().promise;
+				});
+			},
+		],
+		Settings.isolated({ "edit.enforceSeenLines": false }),
+	);
+	try {
+		const target = path.join(cwd, "target.txt");
+		await writeFile(target, "old\n");
+		const edit = session.getToolByName("edit")!;
+		const input = { input: `[target.txt#${hashlineFileHash("old\n")}]\nPUT 1.=1:\n+new` };
+		const failure = await edit.execute("guard-throw", input);
+		expect(failure.isError).toBe(true);
+		expect(await readFile(target, "utf8")).toBe("old\n");
+		action = "wait";
+		const controller = new AbortController();
+		const executing = edit.execute("guard-abort", input, controller.signal);
+		await entered.promise;
+		controller.abort();
+		await executing;
+		expect(await readFile(target, "utf8")).toBe("old\n");
+	} finally {
+		await session.dispose();
+	}
+});
+
+it("no listeners retain ordinary writer configuration; a registered guard holds conflicts", async () => {
+	for (const guarded of [false, true]) {
+		const settings = Settings.isolated({ "lsp.formatOnWrite": true, "edit.enforceSeenLines": false });
+		const { session, cwd } = await createWorkspace(
+			guarded
+				? [
+						api => {
+							api.on("edit_prepared", () => ({ block: false }));
+						},
+					]
+				: [],
+			settings,
+		);
+		try {
+			const target = path.join(cwd, "target.txt");
+			await writeFile(target, "old\n");
+			const result = await session.getToolByName("edit")!.execute(`configuration-${guarded}`, {
+				input: `[target.txt#${hashlineFileHash("old\n")}]\nPUT 1.=1:\n+new`,
+			});
+			expect(result.isError === true).toBe(guarded);
+			expect(await readFile(target, "utf8")).toBe(guarded ? "old\n" : "new\n");
+			expect(settings.get("lsp.formatOnWrite")).toBe(true);
+		} finally {
+			await session.dispose();
+		}
+	}
+});
+
+it("a denied final edit drains prior permitted diagnostics without formatting or retaining the batch", async () => {
+	const { session, cwd } = await createWorkspace(
+		[
+			api => {
+				api.on("edit_prepared", event => ({ block: event.toolCallId === "batch-final" }));
+			},
+		],
+		Settings.isolated({ "edit.enforceSeenLines": false, "lsp.diagnosticsOnEdit": true }),
+		true,
+	);
+	const linted: string[] = [];
+	let formats = 0;
+	getConfig(cwd).servers = {
+		"edit-guard-batch": {
+			command: "edit-guard-batch",
+			fileTypes: [".guarddiag"],
+			rootMarkers: [],
+			createClient: () => ({
+				format: async () => {
+					formats++;
+					return "UNAUTHORIZED FORMAT\n";
+				},
+				lint: async file => {
+					linted.push(file);
+					expect(await readFile(file, "utf8")).toBe("permitted\n");
+					return [
+						{
+							range: { start: { line: 0, character: 0 }, end: { line: 0, character: 1 } },
+							severity: 1,
+							message: "diagnostic from the earlier permitted edit",
+						},
+					];
+				},
+			}),
+		},
+	};
+	try {
+		const first = path.join(cwd, "first.guarddiag");
+		const last = path.join(cwd, "last.guarddiag");
+		await writeFile(first, "old\n");
+		await writeFile(last, "old\n");
+		const toolCalls = [
+			{ id: "batch-first", name: "edit" },
+			{ id: "batch-final", name: "edit" },
+		];
+		const edit = session.getToolByName("edit")!;
+		const context = {
+			sessionManager: session.sessionManager,
+			modelRegistry: registry,
+			model: session.model,
+			isIdle: () => !session.isStreaming,
+			hasQueuedMessages: () => session.queuedMessageCount > 0,
+			abort: () => session.agent.abort(),
+			settings: session.settings,
+		};
+		const firstResult = await edit.execute(
+			"batch-first",
+			{
+				input: `[first.guarddiag#${hashlineFileHash("old\n")}]\nPUT 1.=1:\n+permitted`,
+			},
+			undefined,
+			undefined,
+			{ ...context, toolCall: { batchId: cwd, index: 0, total: 2, toolCalls } },
+		);
+		expect(firstResult.isError).not.toBe(true);
+		expect(await readFile(first, "utf8")).toBe("permitted\n");
+		expect(linted).toEqual([]);
+		const denied = await edit.execute(
+			"batch-final",
+			{
+				input: `[last.guarddiag#${hashlineFileHash("old\n")}]\nPUT 1.=1:\n+denied`,
+			},
+			undefined,
+			undefined,
+			{ ...context, toolCall: { batchId: cwd, index: 1, total: 2, toolCalls } },
+		);
+		expect(denied.isError).toBe(true);
+		expect(await readFile(first, "utf8")).toBe("permitted\n");
+		expect(await readFile(last, "utf8")).toBe("old\n");
+		expect(linted).toEqual([first]);
+		expect(formats).toBe(0);
+		expect(
+			denied.content.some(
+				block => block.type === "text" && block.text.includes("diagnostic from the earlier permitted edit"),
+			),
+		).toBe(true);
+		expect(await flushLspWritethroughBatch(cwd, cwd)).toBeUndefined();
+	} finally {
+		await session.dispose();
+	}
+});
